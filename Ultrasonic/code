// Define the ESP32 pin connections
const int trigPin = 5;
const int echoPin = 18;

// Define variables for calculating distance
long duration;
float distanceCm;
float distanceInch;

void setup() {
  // Start the Serial Monitor at 115200 baud rate
  Serial.begin(115200);
  
  // Set the pin modes
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
}

void loop() {
  // 1. Clear the TRIG pin by setting it LOW for 2 microseconds
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  
  // 2. Trigger the sensor by setting the TRIG pin HIGH for 10 microseconds
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  // 3. Read the ECHO pin (returns the sound wave travel time in microseconds)
  duration = pulseIn(echoPin, HIGH);
  
  // 4. Calculate the distance
  // Speed of sound is ~343 m/s or 0.0343 cm/microsecond
  // Divide by 2 because the wave travels out and back
  distanceCm = duration * 0.0343 / 2;
  distanceInch = distanceCm / 2.54;
  
  // 5. Print the results to the Serial Monitor
  Serial.print("Distance: ");
  Serial.print(distanceCm);
  Serial.print(" cm  |  ");
  Serial.print(distanceInch);
  Serial.println(" inches");
  
  // Wait half a second before taking the next reading
  delay(500);
}
