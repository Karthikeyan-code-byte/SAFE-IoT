#include <ESP32Servo.h>

// =====================================================
// ESP32-S3 SERVO MOTOR TEST
// =====================================================

Servo myServo;

// ESP32-S3 servo signal pin
const int servoPin = 16;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("ESP32-S3 Servo Test");
  Serial.println("Servo Signal = GPIO 16");

  // Standard servo frequency
  myServo.setPeriodHertz(50);

  // Attach servo
  myServo.attach(servoPin, 500, 2400);

  // Start at 0 degrees
  myServo.write(0);

  delay(1000);
}

void loop() {

  // Sweep 0 -> 180 degrees
  for (int pos = 0; pos <= 180; pos++) {
    myServo.write(pos);
    delay(15);
  }

  delay(500);

  // Sweep 180 -> 0 degrees
  for (int pos = 180; pos >= 0; pos--) {
    myServo.write(pos);
    delay(15);
  }

  delay(500);
}
