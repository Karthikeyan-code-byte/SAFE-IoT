#include <WiFi.h>
#include <WebServer.h>

// Replace with your network credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// Define the LED pin for ESP32-S3 (GPIO 8 is commonly used on ESP32-S3 boards)
const int ledPin = 8; 

// Create a web server running on port 80
WebServer server(80);

// HTML for the webpage stored in Flash Memory
const char htmlPage[] PROGMEM = R"=====(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial; text-align: center; margin-top: 50px; background-color: #0f172a; color: #ffffff; }
    h1 { color: #38bdf8; }
    .btn { background-color: #4CAF50; color: white; padding: 16px 40px; 
           font-size: 22px; border: none; border-radius: 8px; cursor: pointer; margin: 10px; text-decoration: none; display: inline-block; }
    .btn-off { background-color: #f44336; }
  </style>
</head>
<body>
  <h1>ESP32-S3 Web Server</h1>
  <p>LED Control Dashboard</p>
  <a href="/on"><button class="btn">TURN ON</button></a><br>
  <a href="/off"><button class="btn btn-off">TURN OFF</button></a>
</body>
</html>
)=====";

void setup() {
  // Initialize Serial Monitor
  Serial.begin(115200);

  // Allow USB CDC on ESP32-S3 to establish connection
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 3000));
  delay(1000);

  pinMode(ledPin, OUTPUT);
  digitalWrite(ledPin, LOW); // Start with LED off

  // Configure Wi-Fi Mode
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.println("\nConnecting to Wi-Fi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("====================================");
  Serial.println("  ESP32-S3 WI-FI CONNECTED!");
  Serial.print("  IP Address: http://");
  Serial.println(WiFi.localIP());
  Serial.println("====================================");

  // Define HTTP route handlers
  server.on("/", []() {
    server.send(200, "text/html", htmlPage);
  });

  server.on("/on", []() {
    digitalWrite(ledPin, HIGH);
    Serial.println("LED State -> HIGH (ON)");
    server.send(200, "text/html", htmlPage); // Reload page
  });

  server.on("/off", []() {
    digitalWrite(ledPin, LOW);
    Serial.println("LED State -> LOW (OFF)");
    server.send(200, "text/html", htmlPage); // Reload page
  });

  // Start HTTP Server
  server.begin();
  Serial.println("HTTP Server Started Successfully.");
}

void loop() {
  // Handle incoming web client requests
  server.handleClient();
}
